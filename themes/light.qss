* {
    font-family: "Segoe UI";
}

QMainWindow {
    background: #F5F6F8;
    color: #1A1C20;
}

QToolBar#mainToolbar {
    background: #FFFFFF;
    border: none;
    border-bottom: 1px solid #E1E3E8;
    spacing: 12px;
    min-height: 64px;
}

QLabel#toolbarTitle {
    color: @ACCENT@;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 1px;
}

QFrame#sidebar {
    background: #FFFFFF;
    border-right: 1px solid #E1E3E8;
}

QListWidget#navigation {
    background: transparent;
    border: none;
    outline: none;
    color: #5B6270;
    font-size: 14px;
}

QListWidget#navigation::item {
    padding: 14px 14px;
    border-radius: 8px;
}

QListWidget#navigation::item:hover {
    background: #EEF0F3;
    color: #1A1C20;
}

QListWidget#navigation::item:selected {
    background: @ACCENT@;
    color: #FFFFFF;
    font-weight: 600;
}

QLabel#pageHeading {
    color: #1A1C20;
    font-size: 32px;
    font-weight: 700;
}

QLabel#pageSubtitle {
    color: #6B7280;
    font-size: 14px;
}

QLabel#sectionHeading {
    color: #1A1C20;
    font-size: 18px;
    font-weight: 600;
}

QFrame#statCard,
QFrame#contentPanel {
    background: #FFFFFF;
    border: 1px solid #E1E3E8;
    border-radius: 12px;
}

QLabel#statTitle {
    color: #6B7280;
    font-size: 11px;
    font-weight: 700;
}

QLabel#statValue {
    color: #1A1C20;
    font-size: 28px;
    font-weight: 700;
}

QLabel#statSubtitle {
    color: #8A8F98;
    font-size: 12px;
}

QLabel#statIcon {
    font-size: 20px;
}

/* --- Dashboard: Up Next hero card --------------------------------------- */

QFrame#posterHoverPreview {
    background: #FFFFFF;
    border: 2px solid @ACCENT@;
    border-radius: 12px;
}

QLabel#posterHoverPreviewTitle {
    color: #383C44;
    font-size: 13px;
    font-weight: 600;
}

QFrame#upNextCard {
    background: #FFFFFF;
    border: 1px solid @ACCENT@;
    border-radius: 12px;
}

QFrame#calendarDayCell {
    background: #FFFFFF;
    border: 1px solid #D7DAE0;
    border-radius: 8px;
}

QFrame#calendarDayCellToday {
    background: #FFFFFF;
    border: 2px solid @ACCENT@;
    border-radius: 8px;
}

QLabel#calendarDayNumber {
    color: #686D78;
    font-size: 12px;
    font-weight: 600;
}

QLabel#calendarReleaseTitle {
    color: #383C44;
    font-size: 11px;
}

QLabel#calendarMoreLabel {
    color: #858A95;
    font-size: 10px;
}

QLabel#upNextEyebrow {
    color: @ACCENT@;
    font-size: 11px;
    font-weight: 700;
}

QLabel#upNextTitle {
    color: #1A1D23;
    font-size: 16px;
    font-weight: 700;
}

/* --- Dashboard: "Coming Soon" chips -------------------------------------- */

QFrame#upcomingChip {
    background: #FFFFFF;
    border: 1px solid #E4E6EB;
    border-radius: 10px;
}

QLabel#upcomingChipTitle {
    color: #383C44;
    font-size: 12px;
    font-weight: 600;
}

QLabel#upcomingChipCountdown {
    color: @ACCENT@;
    font-size: 11px;
    font-weight: 700;
}

QLabel#emptyState {
    color: #8A8F98;
    font-size: 15px;
}

QLineEdit#searchBox {
    background: #FFFFFF;
    color: #1A1C20;
    border: 1px solid #D7DAE0;
    border-radius: 8px;
    padding: 11px 14px;
    font-size: 14px;
}

QLineEdit#searchBox:focus {
    border: 1px solid @ACCENT@;
}

QPushButton {
    border: none;
    border-radius: 8px;
    padding: 10px 16px;
    font-weight: 600;
    /* See themes/dark.qss for why an explicit fallback color matters
       here -- same fix, light-theme text color. */
    color: #383C44;
}

QPushButton#secondaryButton,
QPushButton#iconButton {
    background: #EEF0F3;
    color: #383C44;
}

QPushButton#secondaryButton:hover,
QPushButton#iconButton:hover {
    background: #E1E4E9;
}

QPushButton#iconButton {
    min-width: 40px;
    max-width: 40px;
}

QStatusBar {
    background: #FFFFFF;
    color: #8A8F98;
    border-top: 1px solid #E1E3E8;
}

QLabel#statusChip {
    color: #5B6270;
    font-size: 12px;
    padding: 0 12px;
    border-left: 1px solid #E1E3E8;
}

QLabel#statusChipOk {
    color: #1B9E5A;
    font-size: 12px;
    font-weight: 600;
    padding: 0 12px;
    border-left: 1px solid #E1E3E8;
}

QLabel#statusChipError {
    color: #D6373D;
    font-size: 12px;
    font-weight: 600;
    padding: 0 12px;
    border-left: 1px solid #E1E3E8;
}

QLabel#toolbarPageLabel {
    color: #6B7280;
    font-size: 15px;
    font-weight: 600;
}

QSplitter#shellSplitter::handle {
    background: #E1E3E8;
}

QSplitter#shellSplitter::handle:hover {
    background: @ACCENT@;
}

/* --- Library: filters, sort, view mode -------------------------------- */

QLabel#inlineLabel {
    color: #6B7280;
    font-size: 13px;
}

QComboBox#filterCombo {
    background: #FFFFFF;
    color: #383C44;
    border: 1px solid #D7DAE0;
    border-radius: 8px;
    padding: 8px 30px 8px 12px;
    font-size: 13px;
    min-width: 120px;
    min-height: 20px;
    /* See themes/dark.qss for why combobox-popup: 0 matters here. */
    combobox-popup: 0;
}

QComboBox#filterCombo:hover {
    border: 1px solid #B7BCC5;
}

QComboBox#filterCombo::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border: none;
}

QComboBox#filterCombo QAbstractItemView {
    background: #FFFFFF;
    color: #383C44;
    border: 1px solid #D7DAE0;
    selection-background-color: @ACCENT@;
    selection-color: #FFFFFF;
    outline: none;
}

QPushButton#filterToggle {
    background: #FFFFFF;
    color: #5B6270;
    border: 1px solid #D7DAE0;
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#filterToggle:hover {
    border: 1px solid #B7BCC5;
}

QPushButton#filterToggle:checked {
    background: @ACCENT@;
    color: #FFFFFF;
    border: 1px solid @ACCENT@;
}

QPushButton#iconButton:checked {
    background: @ACCENT@;
    color: #FFFFFF;
}

QScrollArea#libraryScrollArea {
    background: transparent;
    border: none;
}

/* --- Library: Grid / Poster cards --------------------------------------- */

QFrame#projectCard {
    background: transparent;
}

QFrame#projectCardPoster {
    background: #FFFFFF;
    border: 1px solid #E1E3E8;
    border-radius: 10px;
}

QFrame#projectCard:hover QFrame#projectCardPoster {
    border: 1px solid @ACCENT@;
}

QLabel#cardPosterPlaceholder {
    color: #C7CBD1;
    font-size: 36px;
    font-weight: 800;
}

QLabel#cardStatusBadge {
    color: #FFFFFF;
    background: rgba(26, 28, 32, 0.72);
    border-radius: 5px;
    padding: 3px 7px;
    font-size: 10px;
    font-weight: 700;
}

QLabel#cardIndicators {
    color: #FFFFFF;
    background: rgba(26, 28, 32, 0.72);
    border-radius: 5px;
    padding: 3px 7px;
    font-size: 12px;
}

QLabel#cardTitle {
    color: #1A1C20;
    font-size: 13px;
    font-weight: 600;
    padding-top: 8px;
}

QLabel#cardMeta {
    color: #6B7280;
    font-size: 11px;
    padding-top: 2px;
}

/* --- Library: List / Compact rows --------------------------------------- */

QFrame#projectRow,
QFrame#projectRowCompact {
    background: #FFFFFF;
    border: 1px solid #E1E3E8;
    border-radius: 8px;
}

QFrame#projectRow:hover,
QFrame#projectRowCompact:hover {
    border: 1px solid @ACCENT@;
}

QLabel#rowPosterPlaceholder {
    background: #EEF0F3;
    color: #8A8F98;
    border-radius: 6px;
    font-weight: 700;
    font-size: 11px;
}

QLabel#rowTitle {
    color: #1A1C20;
    font-size: 14px;
    font-weight: 600;
}

QLabel#rowTitleCompact {
    color: #1A1C20;
    font-size: 13px;
    font-weight: 500;
}

QLabel#rowSubtitle {
    color: #6B7280;
    font-size: 12px;
}

QLabel#rowGenres {
    color: #8A8F98;
    font-size: 11px;
}

QLabel#rowStatus {
    color: #5B6270;
    font-size: 12px;
    font-weight: 600;
    min-width: 90px;
}

QLabel#rowRating {
    color: #A6790A;
    font-size: 12px;
    font-weight: 600;
}

QLabel#rowIndicators {
    color: #A6790A;
    font-size: 13px;
}

QLabel#rowColumnCompact {
    color: #6B7280;
    font-size: 12px;
}

/* --- Project Details ----------------------------------------------------- */

QPushButton#primaryButton {
    background: @ACCENT@;
    color: #FFFFFF;
}

QPushButton#primaryButton:hover {
    background: @ACCENT_HOVER@;
}

QPushButton#primaryButton:disabled {
    background: #E9EBEF;
    color: #ABB0B9;
}

QScrollArea#detailScrollArea {
    background: transparent;
    border: none;
}

QScrollArea#settingsScrollArea {
    background: transparent;
    border: none;
}

QFrame#detailPoster {
    background: #FFFFFF;
    border: 1px solid #E1E3E8;
    border-radius: 12px;
}

QLabel#detailPosterPlaceholder {
    color: #C7CBD1;
    font-size: 54px;
    font-weight: 800;
}

QLabel#detailStatusBadge {
    color: #FFFFFF;
    background: rgba(26, 28, 32, 0.72);
    border-radius: 5px;
    padding: 4px 9px;
    font-size: 11px;
    font-weight: 700;
}

QLabel#detailFactLabel {
    color: #6B7280;
    font-size: 11px;
    font-weight: 700;
}

QLabel#detailFactValue {
    color: #383C44;
    font-size: 13px;
    font-weight: 600;
}

QLabel#detailSynopsis {
    color: #383C44;
    font-size: 14px;
}

QLabel#factOfTheDayText {
    color: #383C44;
    font-size: 14px;
    font-style: italic;
}

QLabel#detailNoData {
    color: #8A8F98;
    font-size: 13px;
    font-style: italic;
}

QDoubleSpinBox#ratingSpin {
    background: #FFFFFF;
    color: #383C44;
    border: 1px solid #D7DAE0;
    border-radius: 8px;
    padding: 6px 20px 6px 10px;
    font-size: 13px;
    min-width: 80px;
}

QDoubleSpinBox#ratingSpin:focus {
    border: 1px solid @ACCENT@;
}

QDoubleSpinBox#ratingSpin::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 18px;
    height: 15px;
    border-left: 1px solid #D7DAE0;
    border-top-right-radius: 7px;
    background: #F0F1F4;
}

QDoubleSpinBox#ratingSpin::up-button:hover {
    background: #E4E6EB;
}

QDoubleSpinBox#ratingSpin::up-button:pressed {
    background: #D7DAE0;
}

QDoubleSpinBox#ratingSpin::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 18px;
    height: 15px;
    border-left: 1px solid #D7DAE0;
    border-bottom-right-radius: 7px;
    background: #F0F1F4;
}

QDoubleSpinBox#ratingSpin::down-button:hover {
    background: #E4E6EB;
}

QDoubleSpinBox#ratingSpin::down-button:pressed {
    background: #D7DAE0;
}

QDoubleSpinBox#ratingSpin::up-arrow {
    image: none;
    width: 0px;
    height: 0px;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid #383C44;
}

QDoubleSpinBox#ratingSpin::up-arrow:disabled,
QDoubleSpinBox#ratingSpin::up-arrow:off {
    border-bottom: 5px solid #B7BCC5;
}

QDoubleSpinBox#ratingSpin::down-arrow {
    image: none;
    width: 0px;
    height: 0px;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #383C44;
}

QDoubleSpinBox#ratingSpin::down-arrow:disabled,
QDoubleSpinBox#ratingSpin::down-arrow:off {
    border-top: 5px solid #B7BCC5;
}

QTextEdit#notesEdit {
    background: #FFFFFF;
    color: #383C44;
    border: 1px solid #D7DAE0;
    border-radius: 8px;
    padding: 10px;
    font-size: 13px;
}

QTextEdit#notesEdit:focus {
    border: 1px solid @ACCENT@;
}

QLabel#castCrewEntry {
    color: #383C44;
    font-size: 13px;
    padding: 3px 0;
}

QLabel#watchHistoryEntry {
    color: #5B6270;
    font-size: 12px;
    padding: 4px 0;
    border-bottom: 1px solid #E1E3E8;
}

/* --- Timeline ------------------------------------------------------------ */

QLabel#timelineGroupHeading {
    color: #1A1C20;
    font-size: 16px;
    font-weight: 700;
    padding-bottom: 2px;
    border-bottom: 1px solid #E1E3E8;
}

QToolButton#timelineGroupHeading {
    background: transparent;
    color: #1A1C20;
    font-size: 16px;
    font-weight: 700;
    border: none;
    border-bottom: 1px solid #E1E3E8;
    padding: 2px 0 8px 0;
    text-align: left;
}

QToolButton#timelineGroupHeading:hover {
    color: @ACCENT@;
}

QToolButton#timelineGroupHeading::menu-indicator {
    image: none;
    width: 0;
}

QFrame#timelineMarker {
    background: #FFFFFF;
    border: 1px solid #E1E3E8;
    border-radius: 8px;
}

QFrame#timelineMarker:hover {
    border: 1px solid @ACCENT@;
}

QFrame#timelineMarker[watched="false"] {
    background: #F5F6F8;
}

QLabel#timelineOrderBadge {
    color: #8A8F98;
    font-size: 11px;
    font-weight: 700;
}

QLabel#timelineWatchedIndicator {
    color: #A6790A;
    font-size: 13px;
    font-weight: 700;
}

QLabel#timelineUnwatchedIndicator {
    color: #C7CBD1;
    font-size: 13px;
    font-weight: 700;
}

/* --- Achievements ---------------------------------------------------------- */

QFrame#achievementCard {
    background: #FFFFFF;
    border: 1px solid #E1E3E8;
    border-radius: 12px;
}

QFrame#achievementCard[unlocked="false"] {
    background: #F5F6F8;
    border: 1px solid #E9EBEF;
}

QLabel#achievementIcon {
    font-size: 28px;
}

QLabel#achievementName {
    color: #1A1C20;
    font-size: 15px;
    font-weight: 700;
}

QFrame#achievementCard[unlocked="false"] QLabel#achievementName {
    color: #8A8F98;
}

QLabel#achievementTierBronze {
    color: #FFFFFF;
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #8B5A2B, stop: 0.5 #CD7F32, stop: 1 #D4915B
    );
    border-radius: 4px;
    padding: 1px 6px;
    font-size: 11px;
    font-weight: 700;
}

QLabel#achievementTierSilver {
    color: #FFFFFF;
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #71767F, stop: 0.5 #C0C0C0, stop: 1 #E8E8E8
    );
    border-radius: 4px;
    padding: 1px 6px;
    font-size: 11px;
    font-weight: 700;
}

QLabel#achievementTierGold {
    color: #FFFFFF;
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #B8860B, stop: 0.5 #F2C94C, stop: 1 #FFE9A8
    );
    border-radius: 4px;
    padding: 1px 6px;
    font-size: 11px;
    font-weight: 700;
}

QLabel#achievementTierPlatinum {
    color: #FFFFFF;
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #7FA6AE, stop: 0.5 #B9F2FF, stop: 1 #E8FDFF
    );
    border-radius: 4px;
    padding: 1px 6px;
    font-size: 11px;
    font-weight: 700;
}

QLabel#achievementTierDiamond {
    color: #FFFFFF;
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #2E86AB, stop: 0.5 #5FD3FF, stop: 1 #C8F4FF
    );
    border-radius: 4px;
    padding: 1px 6px;
    font-size: 11px;
    font-weight: 700;
}

QLabel#achievementTierVibranium {
    color: #FFFFFF;
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #1B0B3B, stop: 0.5 #6C3CE9, stop: 1 #3CE9C8
    );
    border-radius: 4px;
    padding: 1px 6px;
    font-size: 11px;
    font-weight: 700;
}

QLabel#achievementTierMarvelous {
    color: #FFFFFF;
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #E62429, stop: 0.5 #D9A62E, stop: 1 #8636D9
    );
    border-radius: 4px;
    padding: 1px 6px;
    font-size: 11px;
    font-weight: 700;
}

/* --- Achievements: "Sort by Tier" section headers --------------------- */
/* Each title reuses its tier's exact badge color (see achievementTier*
   above) so a section reads as an obvious continuation of that tier's
   own cards, not just an arbitrary divider. Marvelous gets a solid dark
   color here (rather than the badge's white-on-gradient) since a plain
   header label has no gradient background behind it to read against. */

QFrame#achievementSectionHeader {
    border-bottom: 1px solid #E4E6EB;
    padding-bottom: 8px;
}

QLabel#achievementSectionTitleBronze {
    color: #8B5A2B;
    font-size: 18px;
    font-weight: 700;
}

QLabel#achievementSectionTitleSilver {
    color: #6E7580;
    font-size: 18px;
    font-weight: 700;
}

QLabel#achievementSectionTitleGold {
    color: #A6790A;
    font-size: 18px;
    font-weight: 700;
}

QLabel#achievementSectionTitlePlatinum {
    color: #2A7F8C;
    font-size: 18px;
    font-weight: 700;
}

QLabel#achievementSectionTitleDiamond {
    color: #1C8CC7;
    font-size: 18px;
    font-weight: 700;
}

QLabel#achievementSectionTitleVibranium {
    color: #6C3CE9;
    font-size: 18px;
    font-weight: 700;
}

QLabel#achievementSectionTitleMarvelous {
    color: #8636D9;
    font-size: 18px;
    font-weight: 700;
}

QLabel#achievementSectionCount {
    color: #6B7280;
    font-size: 12px;
}

QLabel#achievementDescription {
    color: #6B7280;
    font-size: 12px;
}

QProgressBar#achievementProgress {
    background: #E9EBEF;
    border: none;
    border-radius: 4px;
}

QProgressBar#achievementProgress::chunk {
    background: @ACCENT@;
    border-radius: 4px;
}

QFrame#achievementCard[unlocked="true"] QProgressBar#achievementProgress::chunk {
    background: #388E3C;
}

QLabel#achievementFooter {
    color: #8A8F98;
    font-size: 12px;
}

QLabel#achievementFooterUnlocked {
    color: #2E7D32;
    font-size: 12px;
    font-weight: 600;
}

/* --- Settings: Backups list -------------------------------------------- */

QListWidget#backupsList {
    background: #FFFFFF;
    border: 1px solid #E1E3E8;
    border-radius: 8px;
    color: #383C44;
    font-size: 13px;
    outline: none;
}

QListWidget#backupsList::item {
    padding: 8px 10px;
    border-radius: 6px;
}

QListWidget#backupsList::item:hover {
    background: #EEF0F3;
}

QListWidget#backupsList::item:selected {
    background: @ACCENT@;
    color: #FFFFFF;
}

/* --- Settings: Appearance ------------------------------------------------ */

QPushButton#colorSwatchButton {
    border: 1px solid #D7DAE0;
    border-radius: 6px;
    padding: 0px;
    margin: 0px;
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
}

/* --- Settings: preference panels (Library, Timeline, Notifications, --- */
/* --- Personalization, Privacy) ----------------------------------------- */

QCheckBox#preferenceCheckbox {
    color: #383C44;
    font-size: 13px;
    spacing: 8px;
    padding: 4px 0px;
}

QCheckBox#preferenceCheckbox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #B7BCC5;
    border-radius: 4px;
    background: #FFFFFF;
}

QCheckBox#preferenceCheckbox::indicator:checked {
    background: @ACCENT@;
    border: 1px solid @ACCENT@;
}

QSpinBox#preferenceSpin {
    background: #FFFFFF;
    color: #383C44;
    border: 1px solid #D7DAE0;
    border-radius: 8px;
    padding: 6px 20px 6px 8px;
    font-size: 13px;
}

QSpinBox#preferenceSpin:hover {
    border: 1px solid #B7BCC5;
}

QSpinBox#preferenceSpin::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 18px;
    height: 15px;
    border-left: 1px solid #D7DAE0;
    border-top-right-radius: 7px;
    background: #F0F1F4;
}

QSpinBox#preferenceSpin::up-button:hover {
    background: #E4E6EB;
}

QSpinBox#preferenceSpin::up-button:pressed {
    background: #D7DAE0;
}

QSpinBox#preferenceSpin::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 18px;
    height: 15px;
    border-left: 1px solid #D7DAE0;
    border-bottom-right-radius: 7px;
    background: #F0F1F4;
}

QSpinBox#preferenceSpin::down-button:hover {
    background: #E4E6EB;
}

QSpinBox#preferenceSpin::down-button:pressed {
    background: #D7DAE0;
}

QSpinBox#preferenceSpin::up-arrow {
    image: none;
    width: 0px;
    height: 0px;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid #383C44;
}

QSpinBox#preferenceSpin::up-arrow:disabled,
QSpinBox#preferenceSpin::up-arrow:off {
    border-bottom: 5px solid #B7BCC5;
}

QSpinBox#preferenceSpin::down-arrow {
    image: none;
    width: 0px;
    height: 0px;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #383C44;
}

QSpinBox#preferenceSpin::down-arrow:disabled,
QSpinBox#preferenceSpin::down-arrow:off {
    border-top: 5px solid #B7BCC5;
}

